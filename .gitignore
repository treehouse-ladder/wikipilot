# Obsidian (gitignore needs `**/` because the vault is at wiki/.obsidian/, not the repo root)
**/.obsidian/workspace*
**/.obsidian/cache
# Third-party plugin source code — users install plugins themselves
# from the list in .obsidian/community-plugins.json
**/.obsidian/plugins/
# Iconize plugin's per-user icon library
**/.obsidian/icons/
# Personal-only config; users build their own
**/.obsidian/bookmarks.json
**/.obsidian/hotkeys.json
**/.obsidian/workspaces.json
# Per-session UI state (zoom scale, collapse-filter toggle) — churns on every Obsidian launch
**/.obsidian/graph.json

# qmd index (rebuilt on demand)
.qmd/

# Local credentials (never commit)
.env
.env.*
!.env.example
~/.config/wikipilot/credentials.toml
credentials.toml

# uv
.uv/
